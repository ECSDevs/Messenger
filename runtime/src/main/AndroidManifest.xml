<?xml version="1.0" encoding="utf-8"?>
<!-- Companion shell-runtime app. Its own UID + targetSdk 28 keep the
     process in the legacy untrusted_app_27 SELinux domain (execute/
     execute_no_trans on app_data_file intact), where it hosts the Termux
     bootstrap, its workspace, and serves commands + workspace file
     operations to the main Messenger app over AIDL. Deliberately NOT
     sharedUserId: PackageManager derives an app's SELinux seInfo from the
     HIGHEST targetSdk in its shared user at install time, so sharing a UID
     with the targetSdk-36 main app put this process into the modern
     untrusted_app domain where W^X blocks execution (install-order
     dependent). Distributed alongside the main APK; without it the main
     app disables the agent tools and the terminal.

     The app is also the Termux-style terminal UI: TerminalActivity is the
     launcher, and the main app opens it from 设置 → 高级 → 终端 with an
     explicit component intent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature-level: only builds signed with the same key (the main
         app) may bind to the shell service. -->
    <permission
        android:name="cc.ptoe.messenger.runtime.permission.SHELL"
        android:protectionLevel="signature" />

    <!-- The shell (apt, curl, ping) needs real network sockets; without this
         the app uid lacks the inet group and every socket open is denied. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Messenger Runtime"
        android:allowBackup="false"
        android:theme="@style/Theme.MessengerRuntime">

        <activity
            android:name="cc.ptoe.messenger.runtime.TerminalActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="cc.ptoe.messenger.runtime.ShellService"
            android:exported="true"
            android:permission="cc.ptoe.messenger.runtime.permission.SHELL" />
    </application>
</manifest>
