<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/terminal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF141414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/terminal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/runtime_terminal_title"
            android:textColor="#FFEDEDED"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/terminal_paste_button"
            style="@style/RuntimeTerminalToolbarButton"
            android:contentDescription="@string/runtime_terminal_paste"
            android:text="@string/runtime_terminal_paste" />

        <TextView
            android:id="@+id/terminal_keyboard_button"
            style="@style/RuntimeTerminalToolbarButton"
            android:contentDescription="@string/runtime_terminal_keyboard"
            android:text="⌨" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:defaultFocusHighlightEnabled="false"
            android:focusableInTouchMode="true"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/terminal_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/terminal_status_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/terminal_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/runtime_terminal_preparing"
                android:textColor="#FFCFCFCF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/terminal_extra_keys_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF141414"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/terminal_extra_keys_rows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>
</LinearLayout>
